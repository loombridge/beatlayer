<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the hardened runtime, applied when the app is signed with a
  Developer ID. An unsigned build doesn't carry them.
-->
<plist version="1.0">
<dict>
	<!-- Record from microphones and audio interfaces. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Load third-party plug-ins (AU, VST3, CLAP), which other developers sign. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
